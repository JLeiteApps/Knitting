{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/apps/api/extract.mjs": { "runtime": "nodejs20.x" },
    "app/apps/api/classify.mjs": { "runtime": "nodejs20.x" }
  },
  "routes": [
    { "src": "/api/extract", "dest": "app/apps/api/extract.mjs" },
    { "src": "/api/classify", "dest": "app/apps/api/classify.mjs" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
